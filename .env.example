# Both empty: display the local sample projects.
# Set the service ID only, without https:// or .microcms.io.
MICROCMS_SERVICE_DOMAIN=
# Server-side GET-only key. Do not use a NEXT_PUBLIC_ prefix.
MICROCMS_API_KEY=
# API endpoint name shown in microCMS (not its display name).
MICROCMS_PROJECTS_ENDPOINT=projects

# note creator ID from https://note.com/CREATOR_ID
NOTE_USER_ID=
