# Both empty: display local sample projects only in development. Production shows a configuration error.
# Set the service ID only, without https:// or .microcms.io.
MICROCMS_SERVICE_DOMAIN=
# Server-side GET-only key. Do not use a NEXT_PUBLIC_ prefix.
MICROCMS_API_KEY=
# API endpoint name shown in microCMS (not its display name).
MICROCMS_PROJECTS_ENDPOINT=projects

# note creator ID from https://note.com/CREATOR_ID
NOTE_USER_ID=

# true: add six sample projects and six sample notes after fetched articles.
# Restart the server after changing this value. Leave false for normal display.
SHOW_SAMPLE_CONTENT=false

# Read by the server only. Leave blank to show the design preview.
HOMELAB_PROMETHEUS_URL=
# Optional: select one Proxmox exporter target (the Prometheus instance label).
HOMELAB_PROMETHEUS_INSTANCE=
# Optional when Prometheus requires a bearer token.
HOMELAB_PROMETHEUS_BEARER_TOKEN=
