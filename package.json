{
  "name": "naganuma-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "npm run test:server && npm run test:client",
    "test:server": "node --conditions=react-server --experimental-strip-types --test tests/*.test.mjs",
    "test:client": "node --experimental-strip-types --test tests/client/*.test.mjs",
    "test:e2e": "playwright test",
    "test:lighthouse": "npx --yes @lhci/cli autorun"
  },
  "dependencies": {
    "@next/third-parties": "^16.3.5",
    "fast-xml-parser": "^5.11.1",
    "next": "16.3.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sanitize-html": "^2.17.7",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "jsdom": "30.1.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
